rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Remplace l'adresse ci-dessous par celle du compte administrateur (la même que adminEmail dans js/config.js).
    function isAdmin() { return signedIn() && request.auth.token.email == 'alexandre.philippon@gmail.com'; }

    // Joueurs : chacun gère sa propre fiche (nom, photo). La photo est une petite image JPEG (data URL) ;
    // l'admin peut la retirer et en interdire le renvoi (photoBlocked), ce que le joueur ne peut pas modifier lui-même.
    function photoOk(d) { return !('photo' in d) || d.photo == '' || (d.photo is string && d.photo.size() < 30000 && d.photo.matches('^data:image/jpeg;base64,.*')); }
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && !('photoBlocked' in request.resource.data) && photoOk(request.resource.data));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && photoOk(request.resource.data)
        && request.resource.data.get('photoBlocked', false) == resource.data.get('photoBlocked', false)
        && (!resource.data.get('photoBlocked', false) || request.resource.data.get('photo', '') == resource.data.get('photo', '')));
      allow delete: if isAdmin();
    }
    // Adresses e-mail : visibles seulement par l'admin et par leur propriétaire.
    match /contacts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    // Choix : chacun écrit uniquement les siens. (Le masquage avant la deadline est fait par le site.)
    match /picks/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
    // Résultats, calendrier (annulations, reports), alias : admin seulement.
    match /results/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /config/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    // Boîte à idées et questions : un joueur connecté écrit ; un visiteur sans compte peut poser une question. Seul l'admin lit.
    match /ideas/{id} {
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.kind == 'question' && request.resource.data.text is string && request.resource.data.text.size() < 1600);
      allow read, delete: if isAdmin();
    }
    // Skieurs ajoutés : un joueur peut proposer un nom libre (pending), l'admin gère le reste.
    match /athletes/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.pending == true);
      allow update, delete: if isAdmin();
    }
  }
}
